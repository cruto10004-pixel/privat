# Database (Railway PostgreSQL — подставляется автоматически)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ayugram

# Security
SECRET_KEY=CHANGE_ME_to_random_64_hex_chars
OTP_SECRET=CHANGE_ME_to_another_random_64_hex_chars

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telegram auth bot (Этап 3)
AUTH_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
ADMIN_BOT_TOKEN=987654321:ZZYYXXWWVVUUzzyyxxwwvvuu

# Admin Telegram IDs (comma separated)
ADMIN_TELEGRAM_IDS=123456789,987654321

# App
APP_NAME=AyuGram
DEBUG=false
